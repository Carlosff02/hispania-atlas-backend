# --- Configuracion local del backend Hispania Atlas (Spring Boot) ---------------
# Copia este archivo a `.env` y exporta sus variables antes de arrancar. Este
# `.env.example` SI se versiona (el `.env` no, por eso la regla `!.env.example`
# del .gitignore de la raiz), asi que aqui va un VALOR DE EJEMPLO, nunca la
# contrasena real de tu Postgres.
#
# En PowerShell:
#   $env:DB_URL  = "jdbc:postgresql://localhost:5432/hispania_db"
#   $env:DB_USER = "postgres"
#   $env:DB_PASSWORD = "<tu contrasena>"
#   $env:JWT_SECRET = "<clave de openssl rand -base64 48>"
#   .\mvnw.cmd spring-boot:run

# JDBC de PostgreSQL. `hispania_db` es la base que ya usaba el backend de Quarkus.
DB_URL=jdbc:postgresql://localhost:5432/hispania_db

# Credenciales del usuario de PostgreSQL.
# OJO: cambia la contrasena. `application.properties` NO lleva ninguna por
# defecto a proposito, para que una clave real no acabe en el repositorio.
DB_USER=postgres
DB_PASSWORD=cambia-esta-por-la-tuya

# Puerto del servidor. El proxy de Angular espera el 8080.
PORT=8080

# Origenes permitidos por CORS, separados por coma. En produccion, si el frontend
# y el backend se sirven desde el mismo origen, se puede dejar vacio.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200

# --- Seguridad --------------------------------------------------------------------
# Clave con la que se firman los JWT (HS256). OBLIGATORIA: la aplicacion no
# arranca sin ella, porque una clave fija en el repositorio permitiria a
# cualquiera firmar un token con el rol que quisiera.
# Genera una real con:  openssl rand -base64 48
JWT_SECRET=cambia-esta-por-una-clave-aleatoria-de-64-caracteres

# Horas de validez del token. 8 es un valor corto a proposito: el token no se
# comprueba contra la base en cada peticion, asi que un cambio de rol o una
# desactivacion no tienen efecto hasta que caduca.
JWT_EXPIRATION_HOURS=8

# --- Primer administrador del sistema ---------------------------------------------
# Estas tres variables SOLO se usan en el arranque y solo si la tabla `usuarios`
# esta vacia de ADMIN_SISTEMA. Se pueden borrar despues del primer arranque.
#
# No hay ninguna cuenta sembrada en las migraciones a proposito: una cuenta con
# contrasena fija en el SQL quedaria escrita en el historial de git para siempre.
# Si dejas estas variables vacias, la aplicacion arranca igualmente y no habra
# ningun administrador (util para las pruebas).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
