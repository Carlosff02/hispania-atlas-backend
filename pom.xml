<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.hispania</groupId>
    <artifactId>hispania-backend-spring</artifactId>
    <version>1.0.0</version>
    <name>hispania-backend-spring</name>
    <description>API REST de Hispania Atlas - Spring Boot (capas: presentation / services / persistence)</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Seguridad. `starter-security` aporta el filtro de servlets, BCrypt y la
            cadena de filtros; `starter-oauth2-resource-server` es lo que permite
            validar el JWT entrante y exposes la authorities en el SecurityContext.
            Se eligio JWT y no sesion porque el frontend es un SPA que ya consume
            una API REST stateless: con sesion habria que activar CORS con
            credenciales y el servidor guardaria estado por usuario.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Flyway: desde la v10 el motor de cada base de datos va en un artefacto aparte -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            Spring Boot 4 movio cada autoconfiguracion tecnica a su propio modulo y
            `spring-boot-autoconfigure` ya no las trae. Sin esta dependencia Flyway
            NO se ejecuta: la aplicacion arranca igual (Hibernate valida el esquema y
            las tablas ya existen) y las migraciones se aplicarian silenciosamente
            en el proximo despliegue, al fallar por una columna que falta. Es el
            fallo mas dificil de detectar de este proyecto, porque la app funciona.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            `@WebMvcTest` tambien salio de `spring-boot-test-autoconfigure` en Spring
            Boot 4 y ahora vive aqui, en el paquete
            `org.springframework.boot.webmvc.test.autoconfigure`. Sin este modulo las
            pruebas de slice MVC no compilan.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Testcontainers: las pruebas de integracion levantan un Postgres de verdad
            en Docker en vez de fingirlo con una base en memoria. Es lo unico que
            reproduce de verdad lo que mas se ha roto en este proyecto: los scripts de
            Flyway, el `ddl-auto=validate` de Hibernate contra el esquema migrado y los
            CHECK de Postgres. Un H2 no habria detectado ni el conflicto de categorias
            de V1/V2 ni el enum `Region` que no encajaba con los datos.

            A partir de Testcontainers 2 los modulos llevan prefijo `testcontainers-`
            (`org.testcontainers:postgresql` ya no existe) y su version la fija el
            `testcontainers.version` que declara el parent de Spring Boot, por eso aqui
            no se escribe `<version>`.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Sin Lombok: se conservan los nombres de parámetro para el binding de Spring -->
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
